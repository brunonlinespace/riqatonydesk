<?xml version='1.0' encoding='UTF-8'?>
<component type="desktop-application">
  <id>io.github.brunonlinespace.riqatonydesk</id>
  <name>RiqatonyDesk</name>
  <summary>Workspace-scale RTF editor</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.brunonlinespace">
    <name>Bruno Machado</name>
  </developer>
  <description>
    <p>
      RiqatonyDesk discovers, edits, views, and organizes RTF documents
      across registered workspaces.
    </p>
    <p>
      It combines a Ribbon-based rich-text editor with folder dashboards,
      view-only opening, optional document tabs, and asynchronous scanning.
    </p>
  </description>
  <launchable type="desktop-id">riqatonydesk.desktop</launchable>
  <url type="homepage">https://github.com/brunonlinespace/riqatonydesk</url>
  <url type="bugtracker">https://github.com/brunonlinespace/riqatonydesk/issues</url>
  <provides>
    <binary>riqatonydesk</binary>
    <mediatype>application/rtf</mediatype>
    <mediatype>text/rtf</mediatype>
    <mediatype>application/x-rtf</mediatype>
  </provides>
  <releases>
    <release version="1.0.0" date="2026-11-01"><description><p>Final 1.0.0 promotion of the x19.9 source, preserving editor behavior, Find/Replace fixes, icon assets and packaging functionality.</p></description></release>
  </releases>
  <content_rating type="oars-1.1" />
</component>